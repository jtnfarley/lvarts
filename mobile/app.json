{
  "expo": {
    "name": "LV Art & Music",
    "slug": "lvartsmusic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "backgroundColor": "#000000",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.lvartandmusic.app",
      "adaptiveIcon": {
        "backgroundColor": "#ff7f25",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.lvartandmusic.com",
              "pathPrefix": "/api/auth/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#eb7f2e"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "58343648-26b0-40fb-bf1a-96775ccd282d"
      }
    },
    "owner": "jtnfarley"
  }
}
