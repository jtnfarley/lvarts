{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "scrape-events": {
      "schedule": "0 5 * * *",
      "timezone": "America/New_York",
      "path": "/api/cron/scrape",
      "requestMethod": "GET"
    },
    "import-events": {
      "schedule": "30 5 * * *",
      "timezone": "America/New_York",
      "path": "/api/cron/import-events",
      "requestMethod": "GET"
    }
  }
}
